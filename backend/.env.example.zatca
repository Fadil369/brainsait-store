# ===========================================
# ZATCA & Saudi Payment Integration Config
# ===========================================
#
# This file contains example configuration for ZATCA e-invoicing
# and Saudi payment gateway integration.
# Copy values to your .env file and update with your credentials.

# -----------------
# Application
# -----------------
API_BASE_URL=https://your-domain.com
PRODUCTION=false

# -----------------
# ZATCA Configuration
# -----------------
# Enable ZATCA e-invoicing compliance
ZATCA_ENABLED=true

# Your VAT Registration Number (15 digits starting with 3)
# Example: 300000000000003
# ⚠️ IMPORTANT: Replace XXX with your actual VAT number
ZATCA_VAT_NUMBER=300000000000XXX

# Your Commercial Registration (CR) Number
# Example: 1234567890
# ⚠️ IMPORTANT: Replace with your actual CR number
ZATCA_CR_NUMBER=1234567890XXX

# Your Company Name (English)
# ⚠️ IMPORTANT: Replace with your actual company name
ZATCA_SELLER_NAME=Your Company Name Ltd

# Your Company Name (Arabic)
# ⚠️ IMPORTANT: Replace with your actual company name in Arabic
ZATCA_SELLER_NAME_AR=شركة اسم شركتك المحدودة

# -----------------
# Mada Payment Gateway (Saudi Debit Cards)
# -----------------
# Merchant ID provided by Mada
# ⚠️ IMPORTANT: Replace with your actual Mada merchant ID
MADA_MERCHANT_ID=mada_merchant_XXXXXXXXXX

# API Key provided by Mada
# ⚠️ IMPORTANT: Replace with your actual Mada API key
MADA_API_KEY=mada_key_XXXXXXXXXXXXXXXXXX

# Mada API Endpoint
# Sandbox: https://sandbox.mada.sa
# Production: https://api.mada.sa
MADA_ENDPOINT=https://sandbox.mada.sa

# -----------------
# STC Pay (Digital Wallet)
# -----------------
# Merchant ID provided by STC Pay
# ⚠️ IMPORTANT: Replace with your actual STC Pay merchant ID
STC_PAY_MERCHANT_ID=stcpay_merchant_XXXXXXXXXX

# API Key provided by STC Pay
# ⚠️ IMPORTANT: Replace with your actual STC Pay API key
STC_PAY_API_KEY=stcpay_key_XXXXXXXXXXXXXXXXXX

# STC Pay API Endpoint
# Sandbox: https://sandbox.stcpay.com.sa
# Production: https://api.stcpay.com.sa
STC_PAY_ENDPOINT=https://sandbox.stcpay.com.sa

# -----------------
# Stripe (International Cards)
# -----------------
# Stripe Secret Key
# Test: sk_test_...
# Live: sk_live_...
# ⚠️ IMPORTANT: Replace with your actual Stripe secret key
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Publishable Key (for frontend)
# ⚠️ IMPORTANT: Replace with your actual Stripe publishable key
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Webhook Secret (for signature verification)
# ⚠️ IMPORTANT: Replace with your actual webhook secret
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXX

# -----------------
# Apple Pay (Optional)
# -----------------
APPLE_PAY_MERCHANT_ID=merchant.com.yourcompany.app
APPLE_PAY_DOMAIN=your-domain.com
APPLE_PAY_CERT_PATH=/path/to/merchant_id.cer
APPLE_PAY_KEY_PATH=/path/to/merchant_id.key
APPLE_PAY_CA_PATH=/path/to/AppleRootCA-G3.cer

# -----------------
# Email Configuration
# -----------------
# SMTP Server Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Email Sender Information
FROM_EMAIL=noreply@brainsait.com
FROM_NAME=BrainSAIT Store
FROM_NAME_AR=متجر برين سايت

# -----------------
# SMS Configuration
# -----------------
# SMS Provider: "unifonic" or "taqnyat"
SMS_PROVIDER=unifonic

# --- Unifonic (Option 1) ---
# Application SID from Unifonic
UNIFONIC_APP_SID=your_unifonic_app_sid
# Sender ID (must be approved by Unifonic)
UNIFONIC_SENDER_ID=YourBrand

# --- Taqnyat (Option 2) ---
# API Key from Taqnyat
TAQNYAT_API_KEY=your_taqnyat_api_key
# Sender Name (must be approved by Taqnyat)
TAQNYAT_SENDER=YourBrand

# -----------------
# Additional Payment Gateways (Optional)
# -----------------
# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# HyperPay
HYPERPAY_ENTITY_ID=your_hyperpay_entity_id
HYPERPAY_ACCESS_TOKEN=your_hyperpay_access_token
HYPERPAY_ENDPOINT=https://test.oppwa.com

# Urpay
URPAY_MERCHANT_ID=your_urpay_merchant_id
URPAY_API_KEY=your_urpay_api_key
URPAY_ENDPOINT=https://api.urpay.sa

# ===========================================
# Setup Instructions
# ===========================================
#
# 1. ZATCA Registration
#    - Register your business at https://zatca.gov.sa
#    - Obtain VAT and CR numbers
#    - Get ZATCA API credentials (for production)
#
# 2. Mada Integration
#    - Apply for merchant account at https://mada.com.sa
#    - Complete merchant onboarding process
#    - Obtain sandbox credentials for testing
#
# 3. STC Pay Integration
#    - Register at https://stcpay.com.sa/business
#    - Complete business verification
#    - Get sandbox credentials for testing
#
# 4. Stripe Setup
#    - Create account at https://stripe.com
#    - Enable Saudi Arabia in your account settings
#    - Get API keys from Dashboard > Developers > API keys
#    - Set up webhook endpoint for payment status updates
#
# 5. Email Configuration
#    - For Gmail: Enable 2FA and create App-Specific Password
#    - For other providers: Get SMTP credentials
#    - Configure SPF and DKIM for better deliverability
#
# 6. SMS Configuration
#    - Unifonic: Register at https://unifonic.com
#    - Taqnyat: Register at https://taqnyat.sa
#    - Get sender ID approved (usually takes 1-2 business days)
#
# ===========================================
# Testing Credentials
# ===========================================
#
# For testing purposes, you can use these sandbox/test values:
#
# Stripe Test Cards:
# - Success: 4242424242424242
# - Decline: 4000000000000002
# - 3D Secure: 4000002500003155
#
# Test Phone Numbers (for SMS):
# - Use your real phone number in sandbox mode
# - SMS won't be charged in test mode
#
# Test Mada Cards:
# - Provided by Mada after merchant approval
# - Contact Mada support for sandbox cards
#
# ===========================================
# Security Notes
# ===========================================
#
# ⚠️  IMPORTANT:
# - Never commit .env file to version control
# - Keep API keys and secrets secure
# - Use different credentials for development/production
# - Rotate keys regularly
# - Enable webhook signature verification
# - Use HTTPS in production
# - Implement rate limiting
# - Monitor for suspicious activity
#
# ===========================================
